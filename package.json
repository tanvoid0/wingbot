{
  "name": "wingbot",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "llm:setup": "node llm/scripts/run-pipeline.mjs setup",
    "llm:prepare": "node llm/scripts/run-pipeline.mjs prepare --project wingbot-lol",
    "llm:sync": "node llm/scripts/run-pipeline.mjs sync --project wingbot-lol",
    "llm:ingest": "node llm/scripts/run-pipeline.mjs ingest --project wingbot-lol",
    "llm:ingest:curated": "node llm/scripts/run-pipeline.mjs ingest --project wingbot-lol --require-matchup",
    "llm:fetch-riot": "node llm/scripts/run-pipeline.mjs fetch-riot --project wingbot-lol",
    "llm:fetch-riot:large": "node llm/scripts/run-pipeline.mjs fetch-riot --project wingbot-lol --players 100 --matches-per-player 20",
    "llm:train": "node llm/scripts/run-pipeline.mjs train --project wingbot-lol",
    "llm:eval": "node llm/scripts/run-pipeline.mjs eval --project wingbot-lol",
    "llm:eval:offline": "node llm/scripts/run-pipeline.mjs eval --project wingbot-lol --offline-eval",
    "llm:wingbot-lol": "node llm/scripts/run-pipeline.mjs all --project wingbot-lol --train",
    "llm:wingbot-lol:prepare": "node llm/scripts/run-pipeline.mjs all --project wingbot-lol",
    "train": "node llm/scripts/run-pipeline.mjs all --project wingbot-lol --train",
    "eval": "node llm/scripts/run-pipeline.mjs eval --project wingbot-lol"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.5.3"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.14.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.58.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/table-core": "^8.21.3",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^22.19.21",
    "bits-ui": "^2.18.0",
    "clsx": "^2.1.1",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.0.1",
    "layerchart": "2.0.0-next.27",
    "mdsvex": "^0.11.0",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.6",
    "svelte-sonner": "^1.1.1",
    "sveltekit-superforms": "^2.30.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
